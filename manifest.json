{
  "manifest_version": 3,
  "name": "RaidX AKTU Copy Downloader",
  "version": "1.0.0",
  "description": "Download your AKTU evaluated answer script as a single PDF or ZIP instead of viewing it one page at a time.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RaidX AKTU Copy Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": ["https://aktuexams.in/*"],
  "content_scripts": [
    {
      "matches": ["https://aktuexams.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
